# ---------------- LOAD & PREP ----------------
def load_data():
    raw = pd.read_csv(RAW_PATH)
    agg = pd.read_csv(AGG_PATH)
    raw.columns = raw.columns.str.lower().str.replace(' ', '_')
    agg.columns = agg.columns.str.lower().str.replace(' ', '_')
    return raw, agg

def prepare_block(raw, agg, block_type="DS"):
    if block_type.upper() == "DS":
        df = raw.query("alert_system == 1").copy()
    else:
        df = raw.query("alert_system == 0").copy()

    df = df.sort_values(['id', 'block', 'trial']).reset_index(drop=True)
    df['target'] = (df['user_action'] == 'S').astype(int)  # user's S/N decision

    # DS current rec (present only in DS blocks)
    if 'alarm_output' in df.columns:
        s = df['alarm_output'].astype(str).str.strip().str.lower()
        df['ds_recommends_signal'] = (s == 'alarm').astype(int)
    else:
        df['ds_recommends_signal'] = np.nan

    # Meta
    df['is_first_trial']  = (df['trial'] == 1).astype(int)
    df['is_first_block']  = (df['block'] == 1).astype(int)
    df['purchase_ds_block_num'] = df.groupby('id')['block'].rank(method='dense')

    # Dependency (fixed, allowed within the block)
    dep_col = next((c for c in ['dependency','dependency_agg','dep','user_dependency','dependency_level'] if c in agg.columns), None)
    dep_map = {'independent':1,'low':2,'medium':3,'high':4,'full':5}
    if dep_col:
        a = agg[['id','block',dep_col]].drop_duplicates().copy()
        a['dependency_num'] = a[dep_col].astype(str).str.strip().str.lower().map(dep_map)
        df = df.merge(a[['id','block','dependency_num']].drop_duplicates(),
                      on=['id','block'], how='left')
    else:
        df['dependency_num'] = np.nan

    return df

# ---------------- p_signal: exact Gaussian posterior ----------------
def normal_pdf(x, mu, sigma):
    z = (x - mu) / sigma
    return (1.0 / (sqrt(2.0*pi)*sigma)) * np.exp(-0.5 * z*z)

def compute_p_signal_paper(df, train_prior_pi, center=CENTER_M, sigma=SIGMA):
    """
    Equal-variance SDT. Use system_d as d'.
    mu_S = c + (d'/2)*sigma
    mu_N = c - (d'/2)*sigma
    """
    pi = float(np.clip(train_prior_pi, 1e-6, 1-1e-6))
    dprime = df['system_d'].astype(float).values
    x = df['stimulus'].astype(float).values

    mu_s = center + 0.5 * dprime * sigma
    mu_n = center - 0.5 * dprime * sigma

    ps = pi * normal_pdf(x, mu_s, sigma)
    pn = (1.0 - pi) * normal_pdf(x, mu_n, sigma)
    return ps / (ps + pn + 1e-12)

# ---------------- ROLLING FEATURES (with EB smoothing) ----------------
def _eb_rate_rolling(binary_series, window, alpha=EB_ALPHA, beta=EB_BETA):
    # rolling sum and count, then EB posterior mean
    s = binary_series.rolling(window, min_periods=1).sum()
    n = binary_series.rolling(window, min_periods=1).count()
    return ((s.shift(1) + alpha) / (n.shift(1) + alpha + beta))  # strict shift(1)

def add_rolling_features(df):
    df = df.sort_values(['id','block','trial']).reset_index(drop=True)

    # System indication (current; used only to derive *historical* signals)
    df['system_indicates_signal'] = (df['stimulus'] >= CENTER_M).astype(int)

    # Per-trial bits (for rolling ONLY; current values are never used as features)
    df['tp'] = ((df['user_action']=='S') & (df['event_type']=='S')).astype(int)
    df['fp'] = ((df['user_action']=='S') & (df['event_type']=='N')).astype(int)

    df['system_tp'] = ((df['system_indicates_signal']==1) & (df['event_type']=='S')).astype(int)
    df['system_fp'] = ((df['system_indicates_signal']==1) & (df['event_type']=='N')).astype(int)

    has_ds = df['ds_recommends_signal'].notna().any()
    if has_ds:
        df['ds_tp'] = ((df['ds_recommends_signal']==1) & (df['event_type']=='S')).astype(int)
        df['ds_fp'] = ((df['ds_recommends_signal']==1) & (df['event_type']=='N')).astype(int)
        df['user_ds_agreement'] = (
            ((df['ds_recommends_signal']==1) & (df['user_action']=='S')) |
            ((df['ds_recommends_signal']==0) & (df['user_action']=='N'))
        ).astype(int)

        df['user_tp_given_ds_alarm']    = ((df['user_action']=='S') & (df['event_type']=='S') & (df['ds_recommends_signal']==1)).astype(int)
        df['user_tp_given_ds_no_alarm'] = ((df['user_action']=='S') & (df['event_type']=='S') & (df['ds_recommends_signal']==0)).astype(int)

    df['user_tp_given_system_signal'] = ((df['user_action']=='S') & (df['event_type']=='S') & (df['system_indicates_signal']==1)).astype(int)
    df['user_tp_given_system_noise']  = ((df['user_action']=='S') & (df['event_type']=='S') & (df['system_indicates_signal']==0)).astype(int)

    # Pre-create rolling targets
    bases = ['signal_rate','tp_rate','fp_rate']
    sys_bases = ['system_tp_rate','system_fp_rate']
    cond_sys = ['user_tp_given_system_signal_rate','user_tp_given_system_noise_rate']
    cols = bases + sys_bases + cond_sys

    if has_ds:
        ds_bases = ['ds_tp_rate','ds_fp_rate','user_ds_agreement_rate',
                    'user_tp_given_ds_alarm_rate','user_tp_given_ds_no_alarm_rate']
        cols += ds_bases

    # rolling mean of p_signal as a "stimulus history" proxy (not EB)
    if 'p_signal' in df.columns:
        cols += ['p_signal_mean']

    for w in ROLLING_WINDOWS:
        for c in cols:
            df[f'{c}_rolling_{w}'] = np.nan

    # Per-user strictly-shifted EB rolling
    for uid, sub in df.groupby('id', sort=False):
        s = sub.copy()
        for w in ROLLING_WINDOWS:
            s[f'signal_rate_rolling_{w}'] = _eb_rate_rolling(s['target'], w)
            s[f'tp_rate_rolling_{w}']     = _eb_rate_rolling(s['tp'], w)
            s[f'fp_rate_rolling_{w}']     = _eb_rate_rolling(s['fp'], w)

            s[f'system_tp_rate_rolling_{w}'] = _eb_rate_rolling(s['system_tp'], w)
            s[f'system_fp_rate_rolling_{w}'] = _eb_rate_rolling(s['system_fp'], w)

            s[f'user_tp_given_system_signal_rate_rolling_{w}'] = _eb_rate_rolling(s['user_tp_given_system_signal'], w)
            s[f'user_tp_given_system_noise_rate_rolling_{w}']  = _eb_rate_rolling(s['user_tp_given_system_noise'], w)

            if has_ds:
                s[f'ds_tp_rate_rolling_{w}'] = _eb_rate_rolling(s['ds_tp'], w)
                s[f'ds_fp_rate_rolling_{w}'] = _eb_rate_rolling(s['ds_fp'], w)
                s[f'user_ds_agreement_rate_rolling_{w}'] = _eb_rate_rolling(s['user_ds_agreement'], w)
                s[f'user_tp_given_ds_alarm_rate_rolling_{w}']    = _eb_rate_rolling(s['user_tp_given_ds_alarm'], w)
                s[f'user_tp_given_ds_no_alarm_rate_rolling_{w}'] = _eb_rate_rolling(s['user_tp_given_ds_no_alarm'], w)

            if 'p_signal' in s:
                s[f'p_signal_mean_rolling_{w}'] = s['p_signal'].rolling(w, min_periods=1).mean().shift(1)

        df.loc[s.index, s.columns] = s

    return df

# ---------------- SPLITS ----------------
def per_user_chrono_split(df, test_ratio=0.3, user_col='id'):
    test_mask = np.zeros(len(df), dtype=bool)
    for _, sub in df.groupby(user_col, sort=False):
        n = len(sub); t = max(1, int(np.floor(n*test_ratio)))
        test_mask[sub.index[-t:]] = True
    return np.flatnonzero(~test_mask), np.flatnonzero(test_mask)

def holdout_ids_split(df, user_col='id', train_ratio=0.7, seed=SEED):
    uids = df[user_col].dropna().unique()
    rng = np.random.RandomState(seed)
    rng.shuffle(uids)
    k = int(np.floor(len(uids)*train_ratio))
    train_ids = set(uids[:k]); test_ids = set(uids[k:])
    tr_idx = df.index[df[user_col].isin(train_ids)].values
    te_idx = df.index[df[user_col].isin(test_ids)].values
    return tr_idx, te_idx

def chrono_cv_splits_on_train(df_train, n_folds=3, user_col='id'):
    df = df_train.reset_index(drop=True)
    splits = []
    for k in range(1, n_folds):
        tr_idx, va_idx = [], []
        for _, sub in df.groupby(user_col, sort=False):
            n = len(sub)
            bins = np.linspace(0, n, n_folds + 1).astype(int)
            va_start, va_end = bins[k], bins[k+1]
            tr_idx.extend(sub.index[:va_start].tolist())
            if va_end > va_start:
                va_idx.extend(sub.index[va_start:va_end].tolist())
        splits.append((np.array(tr_idx), np.array(va_idx)))
    return splits

def carve_calibration_from_train(df_train, cal_ratio=0.1, user_col='id'):
    df = df_train.reset_index(drop=True)
    train_core, cal_hold = [], []
    for _, sub in df.groupby(user_col, sort=False):
        n = len(sub); c = max(1, int(np.floor(n*cal_ratio)))
        cal_hold.extend(sub.index[-c:].tolist())
        train_core.extend(sub.index[:-c].tolist())
    return np.array(train_core), np.array(cal_hold)

# ---------------- FEATURES & ABLATIONS ----------------
def build_feature_sets(df, block_type='DS'):
    # Base current-trial + meta (NO raw stimulus)
    base = [
        'p_signal',
        'trial','is_first_trial','block','is_first_block','purchase_ds_block_num',
        'system_d','dependency_num'
    ]
    if block_type.upper() == 'DS' and df['ds_recommends_signal'].notna().any():
        base.insert(1, 'ds_recommends_signal')  # after p_signal

    rolling_cols = [c for c in df.columns if 'rolling_' in c]
    features_full = [c for c in base + rolling_cols if c in df.columns]

    # Group masks for "hard" ablations
    stim_hist = {c for c in df.columns if c.startswith('p_signal_mean_rolling_') or
                 c.startswith('system_tp_rate_rolling_') or
                 c.startswith('system_fp_rate_rolling_') or
                 c.startswith('user_tp_given_system_')}
    ds_hist = {c for c in df.columns if c.startswith('ds_tp_rate_rolling_') or
               c.startswith('ds_fp_rate_rolling_') or
               c.startswith('user_ds_agreement_rate_rolling_') or
               c.startswith('user_tp_given_ds_')}

    feat_sets = {
        'full': features_full,
        'no_stim': [f for f in features_full if not (f.startswith('p_signal') or f.startswith('signal_rate'))],
        'no_historical': [f for f in base if f in df.columns],
        'no_stim_hard': [f for f in features_full if not (f.startswith('p_signal') or f.startswith('signal_rate')) and f not in stim_hist],
    }
    if block_type.upper() == 'DS' and df['ds_recommends_signal'].notna().any():
        feat_sets['no_ds'] = [f for f in features_full if f != 'ds_recommends_signal']
        feat_sets['no_stim_and_ds'] = [f for f in features_full if f not in ('p_signal','ds_recommends_signal')]
        feat_sets['no_ds_hard'] = [f for f in features_full if f != 'ds_recommends_signal' and f not in ds_hist]

    # Order & trim
    if block_type.upper() == 'DS':
        order = ['full','no_stim','no_ds','no_stim_and_ds','no_stim_hard','no_ds_hard','no_historical']
        feat_sets = {k:feat_sets[k] for k in order if k in feat_sets}
    else:
        order = ['full','no_stim','no_stim_hard','no_historical']
        feat_sets = {k:feat_sets[k] for k in order if k in feat_sets}

    # Sanity: ensure no raw 'stimulus' sneaks in
    for k, vs in feat_sets.items():
        assert not any(v == 'stimulus' or v.startswith('stimulus_') for v in vs), f"Raw stimulus leaked into {k}"
    return feat_sets

# ---------------- PARAMS (CACHE) ----------------
def get_or_fit_best_params(key, X, y, cv_splits):
    store = load_params_store()
    if key in store:
        return store[key]
    grid = GridSearchCV(
        xgb.XGBClassifier(random_state=SEED, eval_metric='logloss', n_jobs=-1, tree_method='hist'),
        XGB_PARAM_GRID, cv=cv_splits, scoring='f1', n_jobs=-1, refit=True, verbose=1
    )
    grid.fit(X, y)
    best = grid.best_params_
    store[key] = best
    save_params_store(store)
    return best

# ---------------- LEAK CHECKS ----------------
def leak_checks(df_tr, df_te, feature_cols, tag, allow_warm_start=False):
    msgs = []
    roll_cols = [c for c in feature_cols if 'rolling_' in c]

    def check_first_rows(df, splitname):
        if not roll_cols: return
        first_idx = df.groupby('id', sort=False).head(1).index
        bad = df.loc[first_idx, roll_cols].notna().any(axis=None)
        if bad and not allow_warm_start:
            msgs.append(f"{splitname}: rolling features non-NaN at user's FIRST row in this split.")
    check_first_rows(df_tr, 'Train')
    check_first_rows(df_te, 'Test')

    # disallow current event_type-derived columns (we only allow their *rolling* versions)
    ban = ['tp','fp','system_tp','system_fp','user_tp_given_system_signal','user_tp_given_system_noise',
           'ds_tp','ds_fp','user_ds_agreement','user_tp_given_ds_alarm','user_tp_given_ds_no_alarm']
    touched = [c for c in feature_cols if c in ban]
    if touched:
        msgs.append(f"Feature leak: current-event columns present: {touched}")

    with open(OUT / f'leak_reports_{tag}.txt','w') as f:
        if msgs:
            f.write("\n".join(msgs))
        else:
            f.write("No issues detected.")
    return msgs

# ---------------- TRENDING & DRIFT ----------------
def save_test_predictions_csv(df_te_sorted, yte, proba, tag):
    out = df_te_sorted[['id','block','trial','event_type']].copy()
    out['y_true'] = yte
    out['proba']  = proba
    out = out.sort_values(['id','block','trial']).reset_index(drop=True)
    out['test_rank'] = out.groupby('id').cumcount() + 1
    p = OUT / f'preds_{tag}.csv'
    out.to_csv(p, index=False)
    return p

def trend_from_preds(csv_path, tuned_thresh=None, title=''):
    df = pd.read_csv(csv_path).sort_values(['id','block','trial']).reset_index(drop=True)
    df['pred05'] = (df['proba'] >= 0.5).astype(int)
    if tuned_thresh is not None:
        df['predT'] = (df['proba'] >= tuned_thresh).astype(int)

    bins = [(1,1),(2,5),(6,10),(11,20),(21,40),(41,10**9)]
    rows = []
    for lo, hi in bins:
        m = (df['test_rank'] >= lo) & (df['test_rank'] <= hi)
        if m.sum() < 50:  # skip tiny bins
            continue
        y = df.loc[m,'y_true'].values
        p = df.loc[m,'proba'].values
        pred05 = df.loc[m,'pred05'].values
        acc = accuracy_score(y, pred05)
        f1  = f1_score(y, pred05, zero_division=0)
        auc = roc_auc_score(y, p) if len(np.unique(y)) > 1 else np.nan
        ap  = average_precision_score(y, p)
        row = {'bin': f'{lo}-{(hi if hi<10**9 else "max")}', 'n': int(m.sum()),
               'acc': acc, 'f1': f1, 'auc': auc, 'ap': ap}
        if tuned_thresh is not None:
            predT = df.loc[m,'predT'].values
            row['f1_tuned'] = f1_score(y, predT, zero_division=0)
        rows.append(row)
    tab = pd.DataFrame(rows)
    if not tab.empty:
        tab = tab[['bin','n','acc','f1','auc','ap'] + (['f1_tuned'] if tuned_thresh is not None else [])]
    tab_path = csv_path.with_suffix('.trend.csv')
    tab.to_csv(tab_path, index=False)

    # Plot
    if not tab.empty:
        xs = range(len(tab))
        fig, ax = plt.subplots(figsize=(6,4))
        ax.plot(xs, tab['acc'], marker='o', label='Acc@0.5')
        ax.plot(xs, tab['f1'], marker='o', label='F1@0.5')
        if 'f1_tuned' in tab:
            ax.plot(xs, tab['f1_tuned'], marker='o', label='F1@t*')
        ax.plot(xs, tab['auc'], marker='o', label='AUC')
        ax.set_xticks(xs); ax.set_xticklabels(tab['bin'])
        ax.set_ylabel('Score'); ax.set_title(title); ax.legend()
        fig.tight_layout()
        png = csv_path.with_suffix('.trend.png')
        fig.savefig(png, dpi=160); plt.close(fig)
    return tab_path

def drift_plots(csv_path, tag):
    """Per-user drift within the TEST slice: early vs late user 'S' rate and event_type 'S' rate."""
    df = pd.read_csv(csv_path).sort_values(['id','block','trial']).reset_index(drop=True)
    grp = []
    for uid, sub in df.groupby('id', sort=False):
        m = len(sub)
        if m < 6:
            continue
        k = max(3, m // 3)  # first vs last third (>=3)
        early = sub.iloc[:k]; late = sub.iloc[-k:]
        # user decisions (target) aren't in this CSV; approximate with y_true (user S/Noise label)
        early_userS = early['y_true'].mean()
        late_userS  = late['y_true'].mean()
        early_evtS  = (early['event_type']=='S').mean()
        late_evtS   = (late['event_type']=='S').mean()
        grp.append([uid, early_userS, late_userS, late_userS-early_userS, early_evtS, late_evtS, late_evtS-early_evtS])
    if not grp:
        return
    g = pd.DataFrame(grp, columns=['id','early_userS','late_userS','delta_userS','early_evtS','late_evtS','delta_evtS'])
    g.to_csv(OUT / f'drift_users_{tag}.csv', index=False)

    # Histogram of user drift
    fig, ax = plt.subplots(figsize=(6,4))
    ax.hist(g['delta_userS'], bins=30, alpha=0.9)
    ax.axvline(g['delta_userS'].mean(), color='k', linestyle='--', label=f"mean Δ={g['delta_userS'].mean():.3f}")
    ax.set_title(f'User decision drift (late - early) — {tag}')
    ax.set_xlabel('Δ user S-rate'); ax.set_ylabel('#users'); ax.legend()
    fig.tight_layout(); fig.savefig(OUT / f'drift_users_{tag}.png', dpi=160); plt.close(fig)

# ---------------- TRAIN / EVAL ----------------
def train_eval_xgb(df, feature_cols, run_key, history_mode='strict', n_folds=3):
    split_mode = run_key['split_mode']

    # split on already-sorted df
    if split_mode in ('pooled_chrono_70_30','pooled_chrono_70_30_online'):
        tr_idx, te_idx = per_user_chrono_split(df, test_ratio=0.3)
    elif split_mode == 'holdout_ids_70_30':
        tr_idx, te_idx = holdout_ids_split(df, train_ratio=0.7)
    else:
        raise ValueError("Unknown split_mode")

    # materialize slices
    df_tr = df.iloc[tr_idx].copy().sort_values(['id','block','trial']).reset_index(drop=True)
    df_te = df.iloc[te_idx].copy().sort_values(['id','block','trial']).reset_index(drop=True)

    # prior & p_signal (prior from TRAIN ONLY)
    prior_pi = df_tr['target'].mean()
    if history_mode == 'online' and split_mode.startswith('pooled'):
        # compute p_signal on FULL DF using train prior, then rolling on FULL DF
        df_all = df.copy().sort_values(['id','block','trial']).reset_index(drop=True)
        df_all['p_signal'] = compute_p_signal_paper(df_all, prior_pi, center=CENTER_M, sigma=SIGMA)
        df_all = add_rolling_features(df_all)
        df_tr = df_all.iloc[tr_idx].copy().reset_index(drop=True)
        df_te = df_all.iloc[te_idx].copy().reset_index(drop=True)
        allow_warm_start = True
    else:
        # compute p_signal and rolling per slice (strict)
        df_tr['p_signal'] = compute_p_signal_paper(df_tr, prior_pi, center=CENTER_M, sigma=SIGMA)
        df_te['p_signal'] = compute_p_signal_paper(df_te, prior_pi, center=CENTER_M, sigma=SIGMA)
        df_tr = add_rolling_features(df_tr)
        df_te = add_rolling_features(df_te)
        allow_warm_start = False

    # prior-shift report
    tag_base = f"{run_key['block_type']}_{split_mode}_{run_key['ablation']}_{history_mode}"
    user_train_pos = df_tr['target'].mean()
    user_test_pos  = df_te['target'].mean()
    evt_train_pos  = (df_tr['event_type']=='S').mean()
    evt_test_pos   = (df_te['event_type']=='S').mean()
    with open(OUT / f'priors_{tag_base}.txt', 'w') as f:
        f.write(f"user S-rate: train={user_train_pos:.3f}, test={user_test_pos:.3f}\n")
        f.write(f"event_type S-rate: train={evt_train_pos:.3f}, test={evt_test_pos:.3f}\n")

    # leak checks
    leaks = leak_checks(df_tr, df_te, feature_cols, tag_base, allow_warm_start=allow_warm_start)
    if leaks:
        print(f"[Leak warnings] {tag_base}: {' | '.join(leaks)}")

    # matrices
    Xtr, ytr = df_tr[feature_cols], df_tr['target'].astype(int).values
    Xte, yte = df_te[feature_cols], df_te['target'].astype(int).values

    # calib carve & CV
    if CALIBRATE:
        tr_core_rel, cal_rel = carve_calibration_from_train(df_tr, cal_ratio=CAL_RATIO)
        Xtr_core, ytr_core = Xtr.iloc[tr_core_rel], ytr[tr_core_rel]
        Xcal, ycal = Xtr.iloc[cal_rel], ytr[cal_rel]
        cv_splits = chrono_cv_splits_on_train(df_tr.iloc[tr_core_rel], n_folds=n_folds)
        params_key = f"{run_key['block_type']}|{split_mode}|{history_mode}|{run_key['ablation']}"
        best_params = get_or_fit_best_params(params_key, Xtr_core, ytr_core, cv_splits)
        base = xgb.XGBClassifier(random_state=SEED, eval_metric='logloss', n_jobs=-1, tree_method='hist', **best_params)
        base.fit(Xtr_core, ytr_core)
        clf = CalibratedClassifierCV(estimator=base, method=CAL_METHOD, cv='prefit')
        clf.fit(Xcal, ycal)
        cal_proba = clf.predict_proba(Xcal)[:, 1]
        t_star, _ = best_threshold_f1(ycal, cal_proba)
        base_est = base
    else:
        cv_splits = chrono_cv_splits_on_train(df_tr, n_folds=n_folds)
        params_key = f"{run_key['block_type']}|{split_mode}|{history_mode}|{run_key['ablation']}"
        best_params = get_or_fit_best_params(params_key, Xtr, ytr, cv_splits)
        clf = xgb.XGBClassifier(random_state=SEED, eval_metric='logloss', n_jobs=-1, tree_method='hist', **best_params)
        clf.fit(Xtr, ytr)
        t_star = 0.5
        base_est = clf

    # predict
    proba = clf.predict_proba(Xte)[:, 1]
    pred05 = (proba >= 0.5).astype(int)
    predT  = (proba >= t_star).astype(int)

    # metrics
    acc = accuracy_score(yte, pred05)
    f1  = f1_score(yte, pred05, zero_division=0)
    prc = precision_score(yte, pred05, zero_division=0)
    rec = recall_score(yte, pred05)
    auc = roc_auc_score(yte, proba)
    ap  = average_precision_score(yte, proba)
    brier = brier_score_loss(yte, proba)
    ece = ece_score(yte, proba)

    acc_t = accuracy_score(yte, predT)
    f1_t  = f1_score(yte, predT, zero_division=0)
    prc_t = precision_score(yte, predT, zero_division=0)
    rec_t = recall_score(yte, predT)

    print(f"\n[{run_key['block_type']} | {split_mode} | {run_key['ablation']} | {history_mode}] "
          f"n_train={len(ytr):,}, n_test={len(yte):,}, "
          f"user_pi_train={user_train_pos:.3f}, user_pi_test={user_test_pos:.3f}, "
          f"evt_pi_train={evt_train_pos:.3f}, evt_pi_test={evt_test_pos:.3f}")
    print(f"  Acc={acc:.3f} | F1={f1:.3f} | Prec={prc:.3f} | Rec={rec:.3f} | AUC={auc:.3f} | AP={ap:.3f} | ECE={ece:.3f}")

    # Print & save Top-15 FI
    if hasattr(base_est, 'feature_importances_'):
        fi_df = (pd.DataFrame({'feature': feature_cols, 'importance': base_est.feature_importances_})
                 .sort_values('importance', ascending=False))
        print(f"  Top 15 features:")
        for i, (_, row) in enumerate(fi_df.head(15).iterrows(), 1):
            print(f"    {i:2d}. {row['feature']:<45s} - {row['importance']:.4f}")
        fi_df.head(15).to_csv(OUT / f'feature_importance_top15_{tag_base}.csv', index=False)
    else:
        print("  No feature importance available.")

    # plots
    cm = confusion_matrix(yte, pred05)
    save_cm_plot(cm, tag_base); save_pr_cal_plots(yte, proba, tag_base)

    # Save per-row predictions and trend + drift
    preds_csv = save_test_predictions_csv(df_te, yte, proba, tag_base)
    trend_from_preds(preds_csv, tuned_thresh=t_star, title=tag_base)
    drift_plots(preds_csv, tag_base)

    return {
        'tag': tag_base,
        'n_train': int(len(ytr)),
        'n_test': int(len(yte)),
        'user_pi_train': float(user_train_pos),
        'user_pi_test': float(user_test_pos),
        'evt_pi_train': float(evt_train_pos),
        'evt_pi_test': float(evt_test_pos),
        'acc': acc, 'f1': f1, 'prec': prc, 'rec': rec,
        'auc': auc, 'ap': ap, 'brier': brier, 'ece': ece,
        'acc_tuned': acc_t, 'f1_tuned': f1_t, 'prec_tuned': prc_t, 'rec_tuned': rec_t, 'thresh': t_star,
    }

# ---------------- RUNNER ----------------
def run_block(block_type, split_mode, history_mode):
    raw, agg = load_data()
    df = prepare_block(raw, agg, block_type=block_type)

    print_header(f"{block_type.upper()} BLOCKS — {split_mode} ({history_mode}) — base stats")
    print(f"Trials: {len(df):,} | user S-rate: {df['target'].mean():.4f} | event_type S-rate: {(df['event_type']=='S').mean():.4f}")

    # Build features once (names), after a temporary p_signal + rolling to expose all columns
    tmp = df.copy()
    tmp_prior = tmp['target'].mean()
    tmp['p_signal'] = compute_p_signal_paper(tmp, tmp_prior, center=CENTER_M, sigma=SIGMA)
    tmp = add_rolling_features(tmp)
    feature_sets = build_feature_sets(tmp, block_type=block_type)

    results = []
    for ablation, feats in feature_sets.items():
        run_key = {'block_type': block_type.upper(), 'split_mode': split_mode, 'ablation': ablation}
        res = train_eval_xgb(df.copy(), feats, run_key, history_mode=history_mode, n_folds=3)
        results.append(res)

    # Save summary
    summ = (pd.DataFrame(results).sort_values(['tag'], ascending=True))
    out_csv = OUT / f"summary_{block_type.upper()}_{split_mode}_{history_mode}.csv"
    summ.to_csv(out_csv, index=False)
    print("\n" + "="*74)
    print(f"SUMMARY SAVED → {out_csv}")
    print("="*74)

def main():
    # DS blocks
    for split_mode in ['pooled_chrono_70_30','pooled_chrono_70_30_online','holdout_ids_70_30']:
        hist_mode = 'online' if split_mode.endswith('_online') else 'strict'
        run_block('DS', split_mode, hist_mode)

    # NON-DS blocks
    for split_mode in ['pooled_chrono_70_30','pooled_chrono_70_30_online','holdout_ids_70_30']:
        hist_mode = 'online' if split_mode.endswith('_online') else 'strict'
        run_block('NONDS', split_mode, hist_mode)

    print_header(f"ALL DONE — results in {OUT}/")

if __name__ == '__main__':
    main()
